# Utpost – miljövariabler (M6). Kopiera till .env lokalt om du vill avvika från standardvärdena;
# .env är gitignorerad. I molnet sätts allt detta i plattformen (infra/azure/staging.yaml),
# hemligheterna som secrets – aldrig i en fil som committas.

# API
DATABASE_URL=postgres://utpost:utpost@localhost:5433/utpost        # compose: @postgres:5432 · Azure: @localhost:5432 (sidecar)
MONGO_URL=mongodb://utpost:utpost@localhost:27017/utpost?authSource=admin
JWT_SECRET=utpost-dev-secret-byt-i-molnet                          # HEMLIGHET. Byt i varje miljö. Roteras i plattformen, inte i koden.
PORT=4000
SEED_ON_START=0                                                    # 1 i staging: tom databas vid start → seed + migrate:logs

# Klienten (nginx i client-imagen)
API_UPSTREAM=api:4000                                              # vart /api och /graphql skickas. Azure: localhost:4000
